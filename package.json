{
  "name": "gradreach-agent",
  "version": "0.1.0",
  "private": true,
  "description": "AI-assisted international MSc supervisor, funding, and professor outreach agent",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --experimental-strip-types --test",
    "test:mongodb": "node --experimental-strip-types --import ./scripts/enable-mongodb-integration.ts --test test/mongo-storage.integration.test.ts",
    "test:watch": "node --experimental-strip-types --test --watch",
    "typecheck": "tsc --noEmit",
    "build:server": "tsc -p tsconfig.build.json",
    "build": "npm run typecheck && next build",
    "dev": "node --experimental-strip-types src/interfaces/web-server.ts --dev",
    "web": "node --experimental-strip-types src/interfaces/web-server.ts --dev",
    "start": "npm run build:server && node dist/interfaces/web-server.js",
    "ops:terminal-app": "npm run build:server && node dist/interfaces/terminal-app.js",
    "ops:db-indexes": "npm run build:server && node dist/interfaces/create-indexes.js",
    "ops:db-migrate-discovery": "npm run build:server && node dist/interfaces/migrate-discovery-collections.js",
    "ops:discovery-batch": "npm run build:server && node dist/interfaces/discover-professor-batch.js",
    "ops:discovery-pilot": "npm run build:server && node dist/interfaces/discover-professor-candidates.js --region",
    "ops:discovery-preflight": "npm run build:server && node dist/interfaces/discovery-preflight.js",
    "ops:discovery-scheduler": "npm run build:server && node dist/interfaces/discovery-scheduler.js",
    "ops:enrich-confirmed-professors": "npm run build:server && node dist/interfaces/enrich-confirmed-professors.js",
    "ops:gmail-connect": "npm run build:server && node dist/interfaces/gmail-connect.js",
    "ops:gmail-selftest": "npm run build:server && node dist/interfaces/gmail-selftest.js",
    "ops:leads-reprocess": "npm run build:server && node dist/interfaces/reprocess-saved-professor-leads.js",
    "ops:outreach-scheduler": "npm run build:server && node dist/interfaces/outreach-scheduler.js",
    "ops:sync-replies": "npm run build:server && node dist/interfaces/gmail-reply-sync.js",
    "debug:leads-view": "node --experimental-strip-types src/interfaces/view-undecided-professor-leads.ts",
    "debug:leads-inspect": "node --experimental-strip-types src/interfaces/inspect-saved-professor-leads.ts",
    "debug:leads-reprocess-audit": "node --experimental-strip-types src/interfaces/audit-saved-lead-reprocessing.ts",
    "debug:discovery-preview:country": "node --experimental-strip-types src/interfaces/discover-professor-preview.ts",
    "debug:discovery-preview:continue": "node --experimental-strip-types src/interfaces/continue-discovery-previews.ts",
    "debug:discovery-preview:all": "node --experimental-strip-types src/interfaces/continue-discovery-previews.ts --all-countries",
    "debug:discovery-preview:audit": "node --experimental-strip-types src/interfaces/diagnose-saved-preview-candidates.ts",
    "debug:discovery-preview:reevaluate": "node --experimental-strip-types src/interfaces/reevaluate-saved-preview-evidence.ts",
    "debug:leads-review-preview": "node --experimental-strip-types src/interfaces/prepare-candidate-review-preview.ts",
    "debug:leads-draft-preview": "node --experimental-strip-types src/interfaces/preview-candidate-03-draft.ts"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.15.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "postcss": "^8.5.32",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "mongodb": "^7.7.0",
    "next": "^16.4.3",
    "next-auth": "^5.0.0-beta.32",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4"
  }
}

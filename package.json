{
  "name": "gradreach-agent",
  "version": "0.1.0",
  "private": true,
  "description": "AI-assisted international MSc supervisor, funding, and professor outreach agent",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --experimental-strip-types --test",
    "test:mongodb": "node --experimental-strip-types --test test/mongo-storage.integration.test.ts",
    "test:watch": "node --experimental-strip-types --test --watch",
    "app": "node --experimental-strip-types src/interfaces/terminal-app.ts",
    "leads:view": "node --experimental-strip-types src/interfaces/view-undecided-professor-leads.ts",
    "discovery:pilot": "node --experimental-strip-types src/interfaces/discover-professor-candidates.ts",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck",
    "db:indexes": "node --experimental-strip-types src/infrastructure/create-indexes.ts",
    "db:migrate-discovery": "node --experimental-strip-types src/interfaces/migrate-discovery-collections.ts",
    "gmail:connect": "node --experimental-strip-types src/interfaces/gmail-connect.ts",
    "outreach:scheduler": "node --experimental-strip-types src/interfaces/outreach-scheduler.ts"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "mongodb": "^7.7.0"
  }
}

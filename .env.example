# Values are read from the process environment; this project does not load .env automatically.
# Keep populated local environment files ignored and never commit credentials.
# MONGODB_URI=mongodb://127.0.0.1:27017/gradreach
# MONGODB_DATABASE=gradreach
# MONGODB_TEST_URI=mongodb://127.0.0.1:27017
# Optional Phase 3 Brave Search API token; keep populated values in ignored local environment files.
# SEARCH_PROVIDER_API_KEY=
# LLM_PROVIDER_API_KEY=
# EMAIL_PROVIDER_CLIENT_ID=
# EMAIL_PROVIDER_CLIENT_SECRET=

# Copy to .env for local development. Values already set in the process environment take precedence.
# Keep populated local environment files private and never commit credentials.
# MONGODB_URI=mongodb://127.0.0.1:27017/gradreach
# MONGODB_DATABASE=gradreach
# MONGODB_TEST_URI=mongodb://127.0.0.1:27017
# Optional Phase 3 Brave Search API token. Live search remains unverified until tested with a real key.
# SEARCH_PROVIDER_API_KEY=
# LLM_PROVIDER_API_KEY=
# Optional Gemini model override; otherwise the adapter currently defaults to gemini-2.5-flash.
# LLM_PROVIDER_MODEL=gemini-2.5-flash
# EMAIL_PROVIDER_CLIENT_ID=
# EMAIL_PROVIDER_CLIENT_SECRET=
# Optional path for the owner-only local OAuth token file (default: private-data/gmail-token.json).
# EMAIL_PROVIDER_TOKEN_PATH=private-data/gmail-token.json
# Sending stays disabled; setting true still cannot bypass the missing daily-cap delivery workflow.
# OUTREACH_SENDING_ENABLED=false
